# Copy to .env.testnet next to compose.testnet.yml. Set TESTNET_SITE_HOST in .env too, so the
# devnet's Caddy (compose.yml), which holds 80 and 443, serves and proxies it.

# The testnet site's public hostname. Without a domain, a second sslip.io name for the same IP
# works, e.g. testnet.<ip-with-dashes>.sslip.io.
TESTNET_SITE_HOST=testnet.89-167-41-133.sslip.io

# The testnet identity seed: every signing key derives from it. As on the devnet, the apps are
# built with it, so anyone who opens them can act as those identities (with test funds only).
# openssl rand -hex 16
RTGS_TESTNET_SEED=

# The central bank's address for this seed (the bootstrap prints it as "centralBank").
RTGS_TESTNET_CENTRAL_BANK=

# Optional: another testnet RPC (the default is SDF's public one), the bank count, and the
# simulator's other flags.
# RTGS_TESTNET_RPC_URL=https://soroban-testnet.stellar.org
# SIM_BANKS=3
# SIM_FLAGS=--rate 0.3 --log json --duration 43200

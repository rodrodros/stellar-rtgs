{$SITE_HOST} {
	encode zstd gzip

	# The devnet's RPC, for the apps in the browser. Friendbot stays private.
	handle /rpc* {
		reverse_proxy quickstart:8000
	}

	# What this site is and how to read it, for LLMs: the SPAs are an empty shell to a fetch.
	# A template, so the host and the central bank come from the environment.
	handle /llms.txt {
		root * /usr/share/rtgs
		templates
		file_server
	}

	# The central bank's and the participants' apps, which the observer links to.
	redir /central-bank /central-bank/
	redir /participant /participant/
	handle /central-bank/* {
		root * /srv
		try_files {path} /central-bank/index.html
		file_server
	}
	handle /participant/* {
		root * /srv
		try_files {path} /participant/index.html
		file_server
	}

	# The observer.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

# The testnet deployment (compose.testnet.yml), whose own Caddy serves plain HTTP on the edge
# network. Without TESTNET_SITE_HOST the block sits on a .localhost name, which needs no
# certificate from the outside.
{$TESTNET_SITE_HOST:testnet.localhost} {
	encode zstd gzip
	reverse_proxy rtgs-testnet-web:80
}

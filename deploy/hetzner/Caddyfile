{$SITE_HOST} {
	encode zstd gzip

	# The devnet's RPC, for the observer in the browser. Friendbot stays private.
	handle /rpc* {
		reverse_proxy quickstart:8000
	}

	# What this site is and how to read it, for LLMs: the SPA is an empty shell to a fetch.
	# A template, so the host and the central bank come from the environment.
	handle /llms.txt {
		root * /usr/share/rtgs
		templates
		file_server
	}

	# The observer, a static SPA.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

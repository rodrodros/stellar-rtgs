# Copy to .env next to compose.yml.

# The public hostname Caddy serves and gets a certificate for. Without a domain, sslip.io
# resolves <ip-with-dashes>.sslip.io to the IP.
SITE_HOST=89-167-41-133.sslip.io

# The devnet identity seed: every signing key derives from it. The central-bank and participant
# apps are built with it, as locally, so anyone who opens them can act as those identities.
# openssl rand -hex 16
RTGS_DEVNET_SEED=

# The central bank's address for this seed (the bootstrap prints it as "centralBank"). The apps
# find the contract and the banks from it.
RTGS_DEVNET_CENTRAL_BANK=

# Optional: the bank count (bootstrap and simulator), and the simulator's other flags.
# SIM_BANKS=3
# SIM_FLAGS=--rate 2 --log json --duration 43200

# Optional: the testnet deployment's hostname (compose.testnet.yml, set up with .env.testnet).
# This Caddy holds 80 and 443, so it serves that site too and proxies it to the testnet's apps.
# TESTNET_SITE_HOST=testnet.89-167-41-133.sslip.io

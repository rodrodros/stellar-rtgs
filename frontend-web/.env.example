# Copy to an app's .env.local (Vite reads VITE_*; Node scripts read the same names with RTGS_).
# Every value is optional; packages/core/README.md lists the defaults.

# Devnet: stellar-implementation's `make devnet-up` (IMPL_PORT, default 8300).
VITE_RTGS_DEVNET_RPC_URL=http://localhost:8300/rpc
# The seed devnet identities derive from (public demo keys, devnet only).
VITE_RTGS_DEVNET_SEED=rtgs-devnet-demo
# Normally discovered from the central bank's account after a bootstrap.
VITE_RTGS_DEVNET_CONTRACT_ID=

# Testnet: point at an existing deployment.
VITE_RTGS_TESTNET_RPC_URL=https://soroban-testnet.stellar.org
VITE_RTGS_TESTNET_CONTRACT_ID=
VITE_RTGS_TESTNET_CENTRAL_BANK=
# G...:Name,G...:Name or a JSON array of { "address", "name" }
VITE_RTGS_TESTNET_BANKS=

# Mainnet: listed only when enabled, and the UI must still ask for confirmation.
VITE_RTGS_ENABLE_MAINNET=false
VITE_RTGS_MAINNET_RPC_URL=
VITE_RTGS_MAINNET_CONTRACT_ID=

# devnet or testnet (never mainnet).
VITE_RTGS_DEFAULT_NETWORK=devnet
# Force capabilities, e.g. expire=available,credit=stub
VITE_RTGS_CAPABILITIES=

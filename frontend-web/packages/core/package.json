{
  "name": "@rtgs/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Networks, contract client, signers, event feed and read models for the RTGS front ends",
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react/index.tsx",

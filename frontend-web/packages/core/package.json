    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "jsdom": "29.1.1",
    "react": "catalog:",
